<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>LLRF loop</name>
  <width>900</width>
  <height>538</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>TITLE</class>
    <text>$(P) LLRF amplitude and phase loops</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>900</width>
    <height>40</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <transparent use_class="true">true</transparent>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>rf_control registers (raw values: setpoints, gains and errors in DSP units); blue fields are read back.</text>
    <x>10</x>
    <y>45</y>
    <width>880</width>
    <height>25</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
