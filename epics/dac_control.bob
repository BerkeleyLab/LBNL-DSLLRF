<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>DAC control</name>
  <width>1100</width>
  <height>521</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>TITLE</class>
    <text>$(P) DACs: waveform length, mode and CW</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>1100</width>
    <height>40</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <transparent use_class="true">true</transparent>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>All DACs length [ns]</text>
    <x>10</x>
    <y>55</y>
    <width>150</width>
    <height>30</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>$(P):DAC:wave_length</pv_name>
    <x>160</x>
    <y>55</y>
    <width>90</width>
    <height>30</height>
    <precision>0</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <tooltip>$(pv_name): pulse (single) or period (loop), 4 ns steps, 0 = all</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>pulse_length [4 ns cycles]</text>
    <x>280</x>
    <y>55</y>
    <width>180</width>
    <height>30</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>$(P):rf_control:pulse_length</pv_name>
    <x>460</x>
    <y>55</y>
    <width>80</width>
    <height>30</height>
    <precision>0</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <tooltip>$(pv_name)</tooltip>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(P):rf_control:pulse_length:RBV</pv_name>
    <x>545</x>
    <y>55</y>
    <width>80</width>
    <height>30</height>
    <background_color>
      <color name="Write_Background" red="128" green="255" blue="255">
      </color>
    </background_color>
    <precision>0</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Apply modes / CW</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P):DAC:apply</pv_name>
        <value>1</value>
        <description>Apply modes / CW</description>
      </action>
    </actions>
    <text>Apply modes / CW</text>
    <x>660</x>
    <y>55</y>
    <width>160</width>
    <height>30</height>
    <tooltip>Make the staged DAC modes and CW values active on all DACs at once ($(P):DAC:apply)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Fill all DACs</text>
    <x>10</x>
    <y>95</y>
    <width>110</width>
    <height>30</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button</name>
    <pv_name>$(P):DAC:fill_ones</pv_name>
    <bit>0</bit>
    <labels_from_pv>true</labels_from_pv>
    <x>120</x>
    <y>95</y>
    <width>120</width>
    <height>30</height>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Loads every DAC waveform at once: 'ones' = constant full-scale I (a CW at the DAC RF frequency once the DACs are enabled), 'zeros' = silent. Overwrites the per-DAC waveforms.</text>
    <x>250</x>
    <y>95</y>
    <width>840</width>
    <height>40</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Modes and CW values are staged: set them for any DACs, then Apply (all DACs change on the same clock). CW frequency = DAC NCO RF frequency. Only on IOCs with one waveform generator per DAC.</text>
    <x>10</x>
    <y>140</y>
    <width>1080</width>
    <height>25</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
