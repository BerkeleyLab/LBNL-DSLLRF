<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>mimo_mts</name>
  <width>1150</width>
  <height>1024</height>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>TITLE</class>
    <text>$(P)</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>530</width>
    <height>50</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="Header_Background" red="77" green="77" blue="77">
      </color>
    </background_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_15</name>
    <pv_name>$(P):rf_control:dac_enable</pv_name>
    <x>950</x>
    <y>140</y>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_35</name>
    <text>DAC Enable</text>
    <x>850</x>
    <y>140</y>
    <height>30</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Entry_14</name>
    <pv_name>$(P):rf_control:pulse_length:RBV</pv_name>
    <x>1060</x>
    <y>210</y>
    <width>80</width>
    <height>30</height>
    <background_color>
      <color name="Write_Background" red="128" green="255" blue="255">
      </color>
    </background_color>
    <precision>0</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_36</name>
    <text>Pulse len [4ns]</text>
    <x>850</x>
    <y>210</y>
    <height>30</height>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="scaledslider" version="2.0.0">
    <name>Scaled Slider_3</name>
    <pv_name>$(P):rf_control:pulse_length</pv_name>
    <x>960</x>
    <y>210</y>
    <width>90</width>
    <height>30</height>
    <show_minor_ticks>false</show_minor_ticks>
    <show_hihi>false</show_hihi>
    <show_high>false</show_high>
    <show_low>false</show_low>
    <show_lolo>false</show_lolo>
    <maximum>8000.0</maximum>
    <limits_from_pv>false</limits_from_pv>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(P):ioc:STARTTOD</pv_name>
    <x>990</x>
    <y>10</y>
    <width>150</width>
  </widget>
