    <name>Spinner_1</name>
    <pv_name>loc://pulse_stat:chan&lt;VLong&gt;(0)</pv_name>
    <x>988</x>
    <y>560</y>
    <width>120</width>
    <height>30</height>
    <format>0</format>
    <precision>0</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
P = widget.getEffectiveMacros().getValue("P")

channel_index = PVUtil.getString(pvs[0])
# start = widget.getDisplayModel().runtimeChildren().getChildByName("Pulse_Start")
amp_plot = widget.getDisplayModel().runtimeChildren().getChildByName("AdcAmpPlot")
phs_plot = widget.getDisplayModel().runtimeChildren().getChildByName("AdcPhsPlot")

# Update plot markers
for plot in [amp_plot, phs_plot]:
    pv_name_start = P + ":DSP:ADC" + channel_index + ":pulse_stat:start_ns"
    pv_name_end = P + ":DSP:ADC" + channel_index + ":pulse_stat:end_ns"
    plot.setPropertyValue("marker[0].pv_name", pv_name_start)
    # plot.setPropertyValue("marker[0].visible", 1)
    plot.setPropertyValue("marker[1].pv_name", pv_name_end)
    # plot.setPropertyValue("marker[1].visible", 1)

# Update pulse statistics
params = ["start_ns", "end_ns", "amp:mean", "amp:std", "phs:mean", "phs:std"]
widget_names = ["Pulse_Start", "Pulse_End", "Pulse_Amp_Mean", "Pulse_Amp_Std", "Pulse_Phs_Mean", "Pulse_Phs_Std"]
for param, name in zip(params, widget_names):
    w = widget.getDisplayModel().runtimeChildren().getChildByName(name)
    pv_name = P + ":DSP:ADC" + channel_index + ":pulse_stat:" + param
    w.setPropertyValue("pv_name", pv_name)
    # print("pulse_stat", channel_index, pv_name)
]]></text>
        <pv_name>$(pv_name)</pv_name>
      </script>
    </scripts>
  </widget>
