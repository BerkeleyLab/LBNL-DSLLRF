<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>RFDC NCO</name>
  <width>900</width>
  <height>890</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>TITLE</class>
    <text>$(P) per-channel NCO</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>900</width>
    <height>40</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <transparent use_class="true">true</transparent>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Set the RF frequency (0 to the sampling rate, e.g. 3000 MHz); the IOC picks the NCO frequency and Nyquist zone. The all-channel setting overwrites the per-channel ones.</text>
    <x>10</x>
    <y>45</y>
    <width>880</width>
    <height>40</height>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>All ADCs RF [MHz]</text>
    <x>10</x>
    <y>95</y>
    <width>140</width>
    <height>30</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>$(P):rfdc_mixer:adc_rf_freq_mhz</pv_name>
    <x>150</x>
    <y>95</y>
    <width>100</width>
    <height>30</height>
    <precision>3</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <tooltip>$(pv_name)</tooltip>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
