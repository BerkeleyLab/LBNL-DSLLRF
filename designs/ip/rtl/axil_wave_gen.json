{
    "ctrl": {
        "address_offset": 0,
        "access": "read-write",
        "size": 64,
        "fields": {
            "trigger": {
                "bit_offset": 0,
                "bit_width": 1,
                "access": "read-write",
                "description": "Trigger waveform output"
            },
            "trigger_mode": {
                "bit_offset": 2,
                "bit_width": 1,
                "access": "read-write",
                "description": "Trigger mode (0=internal, 1=external)"
            }
        }
    },
    "wave_length": {
        "address_offset": 8,
        "access": "read-write",
        "size": 64,
        "description": "Number of output words (OUT_DATA_WIDTH bits each) to play on trigger; 0 plays BANK_DEPTH words"
    },
    "status": {
        "address_offset": 16,
        "access": "read-only",
        "size": 64,
        "fields": {
            "busy": {
                "bit_offset": 0,
                "bit_width": 1,
                "access": "read-only",
                "description": "Playback running"
            },
            "m_axis_tready": {
                "bit_offset": 1,
                "bit_width": 1,
                "access": "read-only",
                "description": "Debug: output stream tready"
            },
            "m_axis_tvalid": {
                "bit_offset": 2,
                "bit_width": 1,
                "access": "read-only",
                "description": "Debug: output stream tvalid"
            },
            "play_row": {
                "bit_offset": 16,
                "bit_width": 16,
                "access": "read-only",
                "description": "Debug: next row to read in the playback"
            }
        }
    },
    "waveform_data": {
        "address_offset": 24,
        "size": 64,
        "access": "write-only",
        "description": "Base address of the waveform memory: a flat byte array in output order, any write size or order"
    }
}
