/dts-v1/;
/plugin/;
/ {

fragment@1 {
    target = <&i2c_clk104>;
    __overlay__ {
        sc18is602@2f {
            /* 1) Disable the old node */
            lmxadc@3 {
                status = "disabled";
            };

            /* 2) Create the new node with reg = 0 */
            lmxadc@0 {
                compatible = "ti,lmx2594";
                reg = <0x0>;
                spi-max-frequency = <400000>;
                num_bytes = <3>;
                status = "okay";
            };
        };
    };
};

};
